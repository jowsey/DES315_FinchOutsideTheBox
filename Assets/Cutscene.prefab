  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneDialogue
  _chatFeed: {fileID: 0}
  _lines:
  - Speaker: {fileID: 1708329029562969784}
    Message: W-we...
  - Speaker: {fileID: 8768362874740993031}
    Message: We made it...
  - Speaker: {fileID: 1708329029562969784}
    Message: WE MADE IT!
  - Speaker: {fileID: 8768362874740993031}
    Message: WE MADE IT! WE MADE IT!
  - Speaker: {fileID: 1708329029562969784}
    Message: WE'RE ALIVE!
  - Speaker: {fileID: 1708329029562969784}
    Message: It's so pretty...
  - Speaker: {fileID: 8768362874740993031}
    Message: Yeah, it is...
  - Speaker: {fileID: 1708329029562969784}
    Message: Almost makes the journey worth it, right?
  - Speaker: {fileID: 8768362874740993031}
    Message: I'm just glad it's over and we never have to do it again...
